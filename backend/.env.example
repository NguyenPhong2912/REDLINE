# Postgres (Render provisions this from render.yaml). Local dev can point at
# the same cloud DB.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
PORT=8787
# Required on any public deployment: write routes (POST) must send x-redline-key.
REDLINE_API_KEY=
RATE_LIMIT_PER_MINUTE=120

# Marketplace take rate. Leave PROTOCOL_TREASURY empty and rentals pay the
# publisher in full, exactly as before the fee existed — that is the mode
# scripts/demo.sh and CHAIN=mock run in. Set it to collect: the fee is split
# out of the rental in the same transaction and verified on-chain.
PROTOCOL_TREASURY=
# Basis points, out of 10000. 1000 = 10%. Capped at 2000; anything higher or
# unparseable falls back to 1000 rather than becoming a rake.
PROTOCOL_FEE_BPS=1000

# CHAIN=mock runs the full flow in-memory with the same 7 gates as the program.
# CHAIN=solana requires the deployed program ID + executor keypair.
# Values printed by `npm run devnet:setup` fill the DEMO_* lines below.
CHAIN=mock
# Mock only: 60 => a 1-minute cooldown elapses in 1 real second (demo pacing).
MOCK_CLOCK_SPEED=60
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
REDLINE_PROGRAM_ID=Fj7MV8Z2a3RdH4W8VF2XKfWAsWHT3jxhoqGMcmb4WbS4
EXECUTOR_KEYPAIR_PATH=./executor.json
# On Render there is no persistent filesystem for a secret file: put the JSON
# array itself in the variable instead of a path.
# EXECUTOR_KEYPAIR_PATH=[12,34,...64 numbers]
# Headless demo only: lets the server sign owner instructions. In the real
# product the owner signs in the browser and posts grantPda + signature.
DEMO_OWNER_KEYPAIR_PATH=./owner.json
DEMO_USDC_MINT=
DEMO_OWNER_WALLET=
DEMO_VAULT_PDA=
DEMO_OPS_DESTINATION=

# Risk copilot and the LLM planner. Unset: the copilot answers from its
# deterministic rules and the runtime falls back to the scripted agent.
#
# Option A: Google Gemini API Studio (Free Tier available at https://aistudio.google.com)
# GEMINI_API_KEY=AIzaSy... (Must start with AIzaSy and be ~39 characters long)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_MODEL=gemini-1.5-flash
#
# Option B: Groq (Free Tier available at https://console.groq.com)
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile
#
# Option C: OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=
LLM_TIMEOUT_MS=15000
