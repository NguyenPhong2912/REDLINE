# Public Solana Devnet RPC. Replace with a dedicated provider for production.
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Server-side only. Configure these in Netlify; never prefix with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# REDLINE backend (backend/ folder). Values below come from `npm run devnet:setup`.
VITE_API_URL=http://localhost:8787
# Must match REDLINE_PROGRAM_ID on the backend: the vault and grant PDAs are
# derived from it, so a mismatch silently signs against a different program.
VITE_REDLINE_PROGRAM_ID=Fj7MV8Z2a3RdH4W8VF2XKfWAsWHT3jxhoqGMcmb4WbS4
VITE_DEMO_USDC_MINT=
VITE_DEMO_OPS_DESTINATION=
# Same value as REDLINE_API_KEY on the backend (write routes).
VITE_API_KEY=
